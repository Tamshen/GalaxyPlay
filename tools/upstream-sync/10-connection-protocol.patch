+            when (called.name) {
+                "asBinder" -> callback
+                "hashCode" -> System.identityHashCode(proxy)
+                "equals" -> proxy === args?.firstOrNull()
+                "toString" -> "DiPlayAutojoinListener"
+                else -> null
