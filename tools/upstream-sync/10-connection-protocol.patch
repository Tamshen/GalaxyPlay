+    fun awaitDetached(timeoutMillis: Long): Boolean {
+        require(timeoutMillis >= 0)
+        val deadline = System.nanoTime() + java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(timeoutMillis)
+        // Kotlin 小集合转换会先读 size 再取首项；并发退出可使该首项已经消失。
